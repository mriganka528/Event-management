# Copy to .env.local and fill in the values. Never commit the filled-in file.

# PostgreSQL connection string. Required.
# On Neon, use the pooled URL here for the application. Migrations automatically
# switch to the direct host; set DIRECT_URL only if your provider does not expose
# a predictable direct twin (Supabase, for example).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional non-pooled URL used only by Prisma CLI commands and migrations. Neon
# derives it from DATABASE_URL; Supabase and similar poolers should set it.
# DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"

# The canonical public origin. Set this in Vercel to the deployment's public URL,
# for example https://planora-sage-ten.vercel.app. Locally, leave it unset (or
# use http://localhost:3000) and the app falls back to localhost.
# Email links, the sitemap, and page metadata all use this value. On Vercel, if
# system environment variables are enabled, VERCEL_PROJECT_PRODUCTION_URL is
# used as a fallback so production email links cannot silently become localhost.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Customer sign-in provider. Staff and administrators do not use it.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/customer/auth/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/customer/auth/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/customer/auth/complete"

# Online payments.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Image uploads.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email, for one-time codes and activation links. Without them the code is
# written to the server log instead of being sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
MAIL_FROM_NAME=""

# Phone two-factor. Leave unset to keep phone codes off; the interface then
# hides the option rather than offering a code that cannot arrive.
# SMS_PROVIDER="http"
# SMS_PROVIDER_URL=""
# SMS_PROVIDER_TOKEN=""

# Session and device limits.
MAX_DEVICES_PER_ACCOUNT="4"
SESSION_MAX_AGE_HOURS="720"
SESSION_FINGERPRINT_SALT=""

# Set when the deployment runs its own Node server rather than a serverless
# platform, so the realtime socket knows which origins to accept.
# APP_URL=""
